# Git Ignore for RevConnect Full-Stack Application

# Compiled Java output
**/target/
*.class
*.jar
*.war

# Node & Frontend build output
**/node_modules/
**/dist/
**/.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secret files
*.pem
*.key
*.crt
*.p12

# Logs
*.log
backend_new.log

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
